generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/zod"
  config   = "../zod.config.json"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String             @id @default(cuid())
  name                   String             @db.VarChar(100)
  email                  String             @unique @db.VarChar(255)
  emailVerified          Boolean            @default(false)
  image                  String?            @db.VarChar(500)
  phone                  String?            @db.VarChar(50)
  address                String?            @db.VarChar(500)
  country                String?            @db.VarChar(100)
  city                   String?            @db.VarChar(100)
  zipCode                String?            @db.VarChar(20)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @default(now()) @updatedAt
  role                   String?
  banned                 Boolean?           @default(false)
  banReason              String?
  banExpires             DateTime?
  onboardingStage        String?
  enterpriseCode         String?            @db.VarChar(50)
  employeeCode           String?            @db.VarChar(50)
  isAnonymous            Boolean?           @default(false)
  doctorAppointments     Appointment[]      @relation("doctorAppointments")
  patientAppointments    Appointment[]      @relation("patientAppointments")
  appointmentChats       AppointmentChat[]
  doctor                 Doctor?
  notifications          Notification[]
  sessions               Session[]
  userSessions           UserSession[]
  accounts               Account[]
  doctorAppointmentNotes AppointmentNotes[] @relation("doctorAppointmentNotes")
  userQueries            UserQuery[]
  userInfo               UserInfo?
  teamMember             TeamMember?

  @@index([email])
  @@index([enterpriseCode])
  @@map("user")
}

model Doctor {
  id                     String                  @id @default(cuid())
  userid                 String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  professional_contact   String
  professional_email     String                  @unique
  secondary_contact      String?
  isAvailable            Boolean                 @default(false)
  isInMeeting            Boolean                 @default(false)
  rejectReason           String?                 @db.Text
  user                   User                    @relation(fields: [userid], references: [id], onDelete: Cascade)
  documents              Documents?
  education              Education[]
  professionalExperience ProfessionalExperience?

  @@index([userid])
  @@index([isAvailable])
}

model UserInfo {
  id          String    @id @default(cuid())
  userId      String    @unique
  gender      String?   @db.VarChar(20)
  dateOfBirth DateTime?
  phone       String?   @db.VarChar(50)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  address     String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserQuery {
  id                String   @id @default(cuid())
  organizationName String   @db.VarChar(200)
  organizationEmail String  @db.VarChar(255)
  message           String   @db.Text
  name              String   @db.VarChar(100)
  number            String   @db.VarChar(50)
  email             String   @db.VarChar(255)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  user              User?    @relation(fields: [userId], references: [id])
  userId            String?

  @@index([userId])
  @@index([email])
}

model Enterprise {
  id               String   @id @default(cuid())
  name             String   @db.VarChar(200)
  code             String   @unique @db.VarChar(50)
  sessionsPerMonth Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([code])
  @@map("enterprise")
}

model Education {
  id               String    @id @default(cuid())
  doctorId         String
  degree           String    @db.VarChar(100)
  startYear        DateTime
  document         String?   @db.VarChar(500)
  endYear          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  institution_name String    @db.VarChar(200)
  doctor           Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

model ProfessionalExperience {
  id                    String    @id @default(cuid())
  doctorId              String    @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  age_group             String    @db.VarChar(100)
  languages             String[]   @default([])
  profession            String
  special_interest_area String
  doctor                Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  @@index([doctorId])
}

model Documents {
  id                String   @id @default(cuid())
  doctorId          String   @unique
  resume            String?  @db.VarChar(500)
  medicalLicense    String?  @db.VarChar(500)
  introductionVideo String?  @db.VarChar(500)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  doctor            Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

model Appointment {
  id                  String             @id @default(cuid())
  doctorId            String
  patientId           String
  status              AppointmentStatus  @default(BOOKED)
  scheduledAt         DateTime?
  startedAt           DateTime?
  endedAt             DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  chatroomExpiry      DateTime?
  age                 Int?
  appointmentFor      String
  issue               String
  uploadId            String?            @db.VarChar(500)
  relationWithPatient String?            @db.VarChar(100)
  patientName         String?            @db.VarChar(100)
  patientAge          Int?
  agoraTokens         AgoraToken[]
  doctor              User               @relation("doctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  patient             User               @relation("patientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  messages            AppointmentChat[]
  userSessions        UserSession[]
  appointmentNotes    AppointmentNotes?
  sessionReason       SessionReason?

  @@index([doctorId])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

model SessionReason {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  reason        SessionReasonType
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([reason])
  @@map("session_reason")
}

model AppointmentNotes {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  doctorId      String
  notes         String      @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        User        @relation("doctorAppointmentNotes", fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([doctorId])
}

model AppointmentChat {
  id            String      @id @default(cuid())
  appointmentId String
  content       String?
  messageType   MessageType @default(TEXT)
  fileUrl       String?     @db.VarChar(500)
  fileName      String?     @db.VarChar(200)
  fileSize      Int?
  senderId      String
  isFromDoctor  Boolean     @default(true)
  isDelivered   Boolean     @default(false)
  isRead        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([senderId])
  @@index([createdAt])
}

model AgoraToken {
  id            String      @id @default(cuid())
  channel       String      @db.VarChar(100)
  doctorToken   String?
  patientToken  String?
  doctorUid     Int?
  patientUid    Int?
  appointmentId String
  patientJoined DateTime?
  doctorJoined  DateTime?
  patientEnded  DateTime?
  doctorEnded   DateTime?
  joinedFirst   String      @db.VarChar(20)
  expiry        DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([channel, appointmentId])
  @@index([appointmentId])
  @@index([expiry])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String   @db.VarChar(200)
  url       String?  @db.VarChar(500)
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model UserSession {
  id            String      @id @default(cuid())
  userId        String
  appointmentId String
  socketId      String      @unique
  isOnline      Boolean     @default(true)
  lastSeen      DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([appointmentId])
  @@index([socketId])
  @@map("UserSession")
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  NO_SHOW
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum SessionReasonType {
  LETTING_OFF_STEAM
  TALKING_THROUGH_STRESS_OR_UNCERTAINTY
  NEEDING_PERSPECTIVE_DURING_A_DEMANDING_PERIOD
}

enum QueryStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rolePermissions RolePermission[]

  @@index([slug])
  @@map("permission")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  rolePermissions RolePermission[]
  teamMembers     TeamMember[]

  @@index([name])
  @@map("role")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permission")
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([roleId])
  @@map("team_member")
}
