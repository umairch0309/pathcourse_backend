{
  "name": "hono-backend-template",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "biome lint && bun build src/index.ts --outdir=dist --external @prisma/client --external prisma --external @aws-sdk/client-s3 --external @aws-sdk/s3-request-presigner --external socket.io",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.946.0",
    "@aws-sdk/s3-request-presigner": "^3.946.0",
    "@hono/zod-openapi": "^1.1.0",
    "@prisma/client": "^6.15.0",
    "@scalar/hono-api-reference": "^0.9.16",
    "agora-token": "^2.0.5",
    "better-auth": "^1.3.8",
    "hono": "^4.9.6",
    "prisma": "^6.19.0",
    "socket.io": "^4.8.3",
    "stoker": "^2.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@types/bun": "latest",
    "prisma-zod-generator": "^1.18.5"
  }
}
